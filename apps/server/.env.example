SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000
PORT=8000

# Composio server credentials. Never expose these to the browser.
COMPOSIO_API_KEY=
COMPOSIO_CALLBACK_URL=http://localhost:8000/api/v1/integrations/composio/callback
COMPOSIO_WEBHOOK_URL=http://localhost:8000/api/v1/integrations/webhooks/composio
COMPOSIO_WEBHOOK_SECRET=
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Use exact trigger slugs/configs from `composio triggers info`.
# These examples use the currently verified read-only triggers. Replace the
# repository and Linear team placeholders before deploying.
COMPOSIO_TRIGGER_DEFINITIONS={"github":[{"slug":"GITHUB_COMMIT_EVENT","config":{"owner":"your-github-owner","repo":"your-github-repository"}}],"slack":[{"slug":"SLACK_CHANNEL_MESSAGE_RECEIVED","config":{}}],"linear":[{"slug":"LINEAR_COMMENT_EVENT_TRIGGER","config":{"team_id":"your-linear-team-id"}},{"slug":"LINEAR_ISSUE_CREATED_TRIGGER","config":{"team_id":"your-linear-team-id"}},{"slug":"LINEAR_ISSUE_UPDATED_TRIGGER","config":{"team_id":"your-linear-team-id"}}]}

# Alternatively, for one GitHub repository without the JSON setting:
# COMPOSIO_GITHUB_OWNER=your-github-owner
# COMPOSIO_GITHUB_REPO=your-github-repository
# COMPOSIO_GITHUB_TRIGGER_SLUG=GITHUB_COMMIT_EVENT

# Standalone Codex device authorization. This is independent from Prized.
CODEX_AUTH_BASE_URL=https://auth.openai.com
# CODEX_CLIENT_ID=
CODEX_AUTH_TIMEOUT_MS=12000
