# Hosted Supabase project. Use the service/secret key only in this process.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Must match the knowledge service configuration.
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8001
KNOWLEDGE_SERVICE_TOKEN=replace-with-a-random-shared-token

WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=5

# Required by `bun run seed`; use the signed-in workspace organization UUID.
SEED_ORGANIZATION_ID=your-organization-uuid
