# Must match the worker and API server token.
KNOWLEDGE_SERVICE_TOKEN=replace-with-a-random-shared-token

# FalkorDB Cloud connection.
FALKORDB_HOST=your-falkordb-host
FALKORDB_PORT=6379
FALKORDB_USERNAME=your-falkordb-username
FALKORDB_PASSWORD=your-falkordb-password
FALKORDB_DATABASE=cloudberry
FALKORDB_SSL=true

# General Compute is used by Graphiti for structured extraction.
GENERALCOMPUTE_API_KEY=your-generalcompute-api-key
GRAPHITI_LLM_BASE_URL=https://api.generalcompute.com/v1
GRAPHITI_LLM_MODEL=gpt-oss-120b
GRAPHITI_LLM_SMALL_MODEL=gpt-oss-120b

# FastEmbed runs locally in the knowledge service.
GRAPHITI_EMBEDDING_PROVIDER=fastembed
GRAPHITI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GRAPHITI_EMBEDDING_DIM=384
KNOWLEDGE_SERVICE_HOST=0.0.0.0
KNOWLEDGE_SERVICE_PORT=8001
