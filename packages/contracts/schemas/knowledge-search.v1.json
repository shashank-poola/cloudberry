{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudberry.app/contracts/knowledge-search.v1.json",
  "title": "KnowledgeSearchRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_id", "query", "limit"],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    }
  }
}
